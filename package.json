{
  "name": "open-quick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-friendly static site hosting inspired by Shopify Quick.",
  "bin": {
    "openquick": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.2",
    "hono": "^4.9.6",
    "mime": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
