{
  "name": "open-quick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-friendly static site hosting inspired by Shopify Quick.",
  "bin": {
    "openquick": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/pro-client.ts --bundle --format=esm --platform=browser --minify --outfile=dist/pro-client.js",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts",
    "gate:promotion": "node scripts/promotion-contract-gate.mjs",
    "receipt:promotion": "node scripts/promotion-receipt.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.2",
    "hono": "^4.9.6",
    "mime": "^4.1.0",
    "mppx": "^0.9.2",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
